# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Transaction-mode pooler (Supavisor / pgBouncer) — used by the FastAPI app.
# In local dev with Docker Compose, port 5433 maps to container 5432.
DATABASE_URL=postgresql+asyncpg://app_tenant:tenant_password@localhost:5433/ragplatform

# Superadmin / platform pooler URL — connects as app_platform (touches tenants & platform_admins only).
PLATFORM_DATABASE_URL=postgresql+asyncpg://app_platform:platform_password@localhost:5433/ragplatform

# Direct connection — used ONLY by Alembic migrations and long-running workers.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ragplatform

# Document ingestion worker - connects as app_worker (can only claim and update ingest_jobs).
# The password below is the development one from infra/postgres/init.sql; use a real secret elsewhere.
WORKER_DATABASE_URL=postgresql+asyncpg://app_worker:worker_password@localhost:5433/ragplatform

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# JWT / Auth
# ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-generate-a-64-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Separate secret for platform (superadmin) JWTs — must differ from SECRET_KEY.
PLATFORM_SECRET_KEY=change-me-different-64-byte-hex-string

# ──────────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM=noreply@platform.local
MAIL_FROM_NAME=RAG Platform

# ──────────────────────────────────────────────
# App behaviour
# ──────────────────────────────────────────────
# The base domain. Tenants are served at {slug}.PLATFORM_DOMAIN.
PLATFORM_DOMAIN=platform.local
# URL the React frontend is served at (used for CORS and email links).
FRONTEND_URL=http://localhost:5173
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set to "development" to enable detailed error responses.
ENVIRONMENT=development
# PUBLIC branding media only (logos, favicons).
UPLOAD_DIR=uploads
# PRIVATE document store (original uploads). Must be separate from UPLOAD_DIR. The API and the
# ingestion worker must both see the same files: put it on a persistent, backed-up volume (backlog B30).
DOCUMENT_STORE_DIR=document_store

# ──────────────────────────────────────────────
# Document limits (design A2). Platform defaults for every tenant; a superadmin can override them per
# tenant (PATCH /api/v1/platform/tenants/{id}/limits) within the hard ceilings in code. (backlog B38)
# ──────────────────────────────────────────────
DOC_MAX_FILE_BYTES=10485760
DOC_MAX_PDF_PAGES=200
DOC_MAX_PPTX_SLIDES=100
QUOTA_MAX_DOCUMENTS=200
QUOTA_MAX_STORAGE_BYTES=524288000
QUOTA_MAX_PAGES=5000
# Uploads per hour
DOC_UPLOAD_RATE_USER=20
DOC_UPLOAD_RATE_TENANT=100
# Manual retries of a failed version: per user per hour, per version per hour, and in total per version
DOC_RETRY_RATE_USER=10
DOC_RETRY_RATE_VERSION=3
DOC_RETRY_MAX_PER_VERSION=5

# ──────────────────────────────────────────────
# Ingestion worker and sweeper (step 5b-2). Start with: python -m app.workers.ingest
# (it refuses to start until the real pipeline stages are assembled in step 5c).
# Needs WORKER_DATABASE_URL (a direct or session-mode connection: the sweeper's advisory lock is
# session-level) and Redis.
# ──────────────────────────────────────────────
INGEST_GLOBAL_CONCURRENCY=2
INGEST_TENANT_CONCURRENCY=1
# Job lease and slot TTL in seconds; a dead worker's job is claimable again after this
INGEST_LEASE_SECONDS=120
# How often the job lease and both slots are renewed (must be well below INGEST_LEASE_SECONDS)
INGEST_HEARTBEAT_SECONDS=30
# Hard cap on one attempt: the slot lease cannot be renewed past this
INGEST_MAX_JOB_SECONDS=1800
INGEST_MAX_ATTEMPTS=3
# Transient retry delay = base * 2^(attempt-1) + random 0..jitter seconds
INGEST_RETRY_BASE_SECONDS=30
INGEST_RETRY_JITTER_SECONDS=15
# A busy slot sends the job back for a random delay in this range (the attempt is refunded)
INGEST_BUSY_MIN_SECONDS=15
INGEST_BUSY_MAX_SECONDS=45
# After SIGTERM the current job gets this long to finish, then it is released
INGEST_SHUTDOWN_GRACE_SECONDS=20
INGEST_FINISHED_JOB_RETENTION_DAYS=7
# Idle poll interval (with jitter)
WORKER_POLL_SECONDS=5
SWEEPER_INTERVAL_SECONDS=60
SWEEPER_MISSING_JOB_AFTER_SECONDS=120
# Soft-deleted documents are purged after this many days
DOC_TOMBSTONE_RETENTION_DAYS=30

# Sandboxed document parser. Memory and CPU limits apply on Linux only (768 on 2 GB hosts).
DOC_PARSE_TIMEOUT_SECONDS=120
DOC_PARSE_MAX_OUTPUT_BYTES=20971520
DOC_PARSE_MEMORY_LIMIT_MB=1024
DOC_PARSE_CPU_SECONDS=120

