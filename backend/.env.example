# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Transaction-mode pooler (Supavisor / pgBouncer) — used by the FastAPI app.
# In local dev with Docker Compose, port 5433 maps to container 5432.
DATABASE_URL=postgresql+asyncpg://app_tenant:tenant_password@localhost:5433/ragplatform

# Superadmin / platform pooler URL — connects as app_platform (touches tenants & platform_admins only).
PLATFORM_DATABASE_URL=postgresql+asyncpg://app_platform:platform_password@localhost:5433/ragplatform

# Direct connection — used ONLY by Alembic migrations and long-running workers.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ragplatform

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# JWT / Auth
# ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-generate-a-64-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Separate secret for platform (superadmin) JWTs — must differ from SECRET_KEY.
PLATFORM_SECRET_KEY=change-me-different-64-byte-hex-string

# ──────────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM=noreply@platform.local
MAIL_FROM_NAME=RAG Platform

# ──────────────────────────────────────────────
# App behaviour
# ──────────────────────────────────────────────
# The base domain. Tenants are served at {slug}.PLATFORM_DOMAIN.
PLATFORM_DOMAIN=platform.local
# URL the React frontend is served at (used for CORS and email links).
FRONTEND_URL=http://localhost:5173
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set to "development" to enable detailed error responses.
ENVIRONMENT=development

