# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
# Transaction-mode pooler (Supavisor / pgBouncer) — used by the FastAPI app.
# In local dev with Docker Compose, port 5433 maps to container 5432.
DATABASE_URL=postgresql+asyncpg://app_tenant:tenant_password@localhost:5433/ragplatform

# Superadmin / platform pooler URL — connects as app_platform (touches tenants & platform_admins only).
PLATFORM_DATABASE_URL=postgresql+asyncpg://app_platform:platform_password@localhost:5433/ragplatform

# Direct connection — used ONLY by Alembic migrations and long-running workers.
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ragplatform

# Document ingestion worker - connects as app_worker (can only claim and update ingest_jobs).
# The password below is the development one from infra/postgres/init.sql; use a real secret elsewhere.
WORKER_DATABASE_URL=postgresql+asyncpg://app_worker:worker_password@localhost:5433/ragplatform

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────────
# JWT / Auth
# ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=change-me-generate-a-64-byte-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Separate secret for platform (superadmin) JWTs — must differ from SECRET_KEY.
PLATFORM_SECRET_KEY=change-me-different-64-byte-hex-string

# ──────────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM=noreply@platform.local
MAIL_FROM_NAME=RAG Platform

# ──────────────────────────────────────────────
# App behaviour
# ──────────────────────────────────────────────
# The base domain. Tenants are served at {slug}.PLATFORM_DOMAIN.
PLATFORM_DOMAIN=platform.local
# URL the React frontend is served at (used for CORS and email links).
FRONTEND_URL=http://localhost:5173
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set to "development" to enable detailed error responses.
ENVIRONMENT=development
# PUBLIC branding media only (logos, favicons).
UPLOAD_DIR=uploads
# PRIVATE document store (original uploads). Must be separate from UPLOAD_DIR. The API and the
# ingestion worker must both see the same files: put it on a persistent, backed-up volume (backlog B30).
DOCUMENT_STORE_DIR=document_store

# ──────────────────────────────────────────────
# Document limits (design A2). Platform defaults for every tenant; a superadmin can override them per
# tenant (PATCH /api/v1/platform/tenants/{id}/limits) within the hard ceilings in code. (backlog B38)
# ──────────────────────────────────────────────
DOC_MAX_FILE_BYTES=10485760
DOC_MAX_PDF_PAGES=200
DOC_MAX_PPTX_SLIDES=100
QUOTA_MAX_DOCUMENTS=200
QUOTA_MAX_STORAGE_BYTES=524288000
QUOTA_MAX_PAGES=5000
# Uploads per hour
DOC_UPLOAD_RATE_USER=20
DOC_UPLOAD_RATE_TENANT=100
# Manual retries of a failed version: per user per hour, per version per hour, and in total per version
DOC_RETRY_RATE_USER=10
DOC_RETRY_RATE_VERSION=3
DOC_RETRY_MAX_PER_VERSION=5
# Test search (teachers and admins): searches per user per window of this many seconds
DOC_TEST_SEARCH_RATE_USER=60
DOC_TEST_SEARCH_RATE_WINDOW_SECONDS=600

# ──────────────────────────────────────────────
# Ingestion worker and sweeper (step 5b-2). Start with: python -m app.workers.ingest
# (it starts only when the embedding model files verify and WORKER_DATABASE_URL, Redis and the document store are
# configured; otherwise it prints why and exits with code 2).
# Needs WORKER_DATABASE_URL (a direct or session-mode connection: the sweeper's advisory lock is
# session-level) and Redis.
# ──────────────────────────────────────────────
INGEST_GLOBAL_CONCURRENCY=2
INGEST_TENANT_CONCURRENCY=1
# Job lease and slot TTL in seconds; a dead worker's job is claimable again after this. At least four times the
# heartbeat. A 1,000-chunk upload embeds for about 5 minutes (2.7-3.5 texts/s measured): the lease is renewed
# every heartbeat and after every embedding batch, so it never has to cover the whole job.
INGEST_LEASE_SECONDS=180
# How often the job lease and both slots are renewed
INGEST_HEARTBEAT_SECONDS=30
# Hard cap on one attempt: the slot lease cannot be renewed past this (the 2,000,000 character ceiling is about 30 minutes)
INGEST_MAX_JOB_SECONDS=3600
INGEST_MAX_ATTEMPTS=3
# A crashed parser child counts against this smaller budget (a file that kills its parser must not loop)
INGEST_MAX_CRASH_ATTEMPTS=2
# Transient retry delay = base * 2^(attempt-1) + random 0..jitter seconds
INGEST_RETRY_BASE_SECONDS=30
INGEST_RETRY_JITTER_SECONDS=15
# A busy slot sends the job back for a random delay in this range (the attempt is refunded)
INGEST_BUSY_MIN_SECONDS=15
INGEST_BUSY_MAX_SECONDS=45
# After SIGTERM the current job gets this long to finish, then it is released
INGEST_SHUTDOWN_GRACE_SECONDS=20
INGEST_FINISHED_JOB_RETENTION_DAYS=7
# Idle poll interval (with jitter)
WORKER_POLL_SECONDS=5
SWEEPER_INTERVAL_SECONDS=60
SWEEPER_MISSING_JOB_AFTER_SECONDS=120
# Soft-deleted documents are purged after this many days
DOC_TOMBSTONE_RETENTION_DAYS=30

# Sandboxed document parser. Memory and CPU limits apply on Linux only (768 on 2 GB hosts).
DOC_PARSE_TIMEOUT_SECONDS=120
# The child's JSON answer as UTF-8; the real maximum is 12.4 MiB (2,000,000 characters of 4 bytes in 100,000 blocks)
DOC_PARSE_MAX_OUTPUT_BYTES=14680064
DOC_PARSE_MEMORY_LIMIT_MB=1024
DOC_PARSE_CPU_SECONDS=120


# Extracted characters per document version (text_too_large above it; also a hard ceiling)
DOC_MAX_TEXT_CHARS=2000000

# ── Embedding model (step 5c-1; python -m app.scripts.fetch_model e5-small --out ./models) ──
# Local verified files only; nothing is downloaded at runtime. Empty EMBEDDING_MODEL_DIR = not configured.
EMBEDDING_MODEL_DIR=
EMBEDDING_MODEL_ID=e5-small
# Texts per model run: 8 measured best (a bigger batch is not faster and costs memory)
EMBEDDING_BATCH_SIZE=8
EMBEDDING_THREADS=1
# Load the query model when the app starts (the first search after a restart is slow otherwise). Leave it
# unset for the default: off in development, on in every other environment. true / false forces it.
# EMBEDDING_WARM_AT_STARTUP=true

# ── Retrieval (step 5d; docs/phase5d-plan.md section 8) ──
RETRIEVAL_VECTOR_K=20
RETRIEVAL_KEYWORD_K=20
RETRIEVAL_FINAL_K=6
RETRIEVAL_RRF_K=60
RETRIEVAL_MAX_QUERY_CHARS=500
# CALIBRATED 2026-11-20 (step 5d-5) for the model in RETRIEVAL_CALIBRATED_MODEL_KEY on 30 should-answer /
# 10 should-not-answer golden questions: 0.84 answers 97% and refuses 70% (docs/api/phase5.md section 12).
# A different embedding model needs a new sweep; until then responses say threshold_calibrated = false.
RETRIEVAL_MIN_SIMILARITY=0.84
# The model the threshold was measured for; threshold_calibrated is true only when the active model key equals it
RETRIEVAL_CALIBRATED_MODEL_KEY=intfloat/multilingual-e5-small@614241f622f53c4eeff9890bdc4f31cfecc418b3
# Keyword-coverage clause of the sufficiency rule; 0 = off. Above 0 it needs RETRIEVAL_RRF_KEYWORD_WEIGHT above 0.
RETRIEVAL_MIN_KEYWORD_COVERAGE=0
# Exact vector scan up to this many candidate chunks, the HNSW index above it
RETRIEVAL_EXACT_MAX_CANDIDATES=50000
# Must be at least RETRIEVAL_VECTOR_K
RETRIEVAL_HNSW_EF_SEARCH=100
# statement_timeout of one search's statements; over it the search is 503 search_timeout
RETRIEVAL_STATEMENT_TIMEOUT_MS=5000
# The keyword side ranks at most this many matching chunks (must be at least RETRIEVAL_KEYWORD_K)
RETRIEVAL_KEYWORD_MAX_CANDIDATES=2000
# Step 5d-4 settings. Step 5d-5 switched the keyword side OFF (keyword weight 0 = vector only; hybrid lost to
# vector only on the golden set). The keyword code stays for later (exact-code search); `eval_retrieval --compare`
# still tries it.
# A keyword word found in more than this share (0 to 1) of the candidate chunks is left out of the keyword query;
# 1 = off. If every word is left out, only the vector side runs.
RETRIEVAL_KEYWORD_MAX_DF=1.0
# Weights of the two sides in the rank fusion (the vector weight must be above 0). Keyword 0 = vector side only:
# the keyword statement is then not run at all. 1.0 / 1.0 is the hybrid of 5d-1 to 5d-4.
RETRIEVAL_RRF_VECTOR_WEIGHT=1.0
RETRIEVAL_RRF_KEYWORD_WEIGHT=0
# A chunk is ranked by the keyword side only if it matches at least this many of the remaining question words
RETRIEVAL_KEYWORD_MIN_MATCHED_TERMS=1
# Query embeddings at once per API process; over the cap a search waits up to RETRIEVAL_EMBED_QUEUE_SECONDS,
# then gets 503 search_busy
RETRIEVAL_EMBED_CONCURRENCY=2
RETRIEVAL_EMBED_QUEUE_SECONDS=5

# ── Chunking, publishing and archiving (step 5c-2) ──
# Content tokens per chunk: target 380, hard maximum 460 (the model limit of 512 also counts the 'passage: ' prefix,
# two special tokens and the heading path), overlap 60
CHUNK_TARGET_TOKENS=380
CHUNK_MAX_TOKENS=460
CHUNK_OVERLAP_TOKENS=60
# The worker publishes a ready, unflagged version by itself. Keep false until the injection scanner (5d) exists.
DOC_AUTO_PUBLISH_ENABLED=false
# An archived version's file is deleted this many days after it was archived
DOC_ARCHIVE_FILE_RETENTION_DAYS=30
# Archived versions kept per document (older ones are pruned)
DOC_MAX_ARCHIVED_VERSIONS=5
