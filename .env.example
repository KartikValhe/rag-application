# Root .env.example (port 5433 maps to Docker Postgres)
DATABASE_URL=postgresql+asyncpg://app_tenant:tenant_password@localhost:5433/ragplatform
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ragplatform
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PLATFORM_SECRET_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM=noreply@platform.local
MAIL_FROM_NAME="RAG Platform"
PLATFORM_DOMAIN=platform.local
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
ENVIRONMENT=development

